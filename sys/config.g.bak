; Configuration file for RepRapFirmware on Duet 3 Mini 5+ Ethernet
; executed by the firmware on start-up
;

; General
G90                                                                 ; absolute coordinates
M83                                                                 ; relative extruder moves
M550 P"Hacedor"                                                     ; set hostname

; Wait a moment for the CAN expansion boards to become available
G4 S2

; Accelerometers
M955 P0 C"121.i2c.lis" I20                                          ; configure accelerometer on board #121

; Smart Drivers
M569 P0.0 S0 D3 V0                                                  ; driver 0.0 goes backwards (Z axis)
M569 P0.1 S1 D3 V0                                                  ; driver 0.1 goes forwards (Z axis)
M569 P0.2 S1 D3 V0                                                  ; driver 0.2 goes forwards (Z axis)
M569 P0.3 S0 D3 V0                                                  ; driver 0.3 goes backwards (Z axis)
M569 P0.5 S1 D3 V0                                                  ; driver 0.5 goes forwards (X axis)
M569 P0.6 S0 D3 V0                                                  ; driver 0.6 goes backwards (Y axis)
M569 P121.0 S0 D3 V0                                                ; driver 121.0 goes backwards (extruder 0)

; Axes
M584 X0.5 Y0.6 Z0.0:0.1:0.2:0.3                                     ; set axis mapping
M350 X16 Y16 Z16 I1                                                 ; configure microstepping with interpolation
M906 X1300 Y1300 Z900                                               ; set axis driver currents
M92 X80 Y80 Z400                                                    ; configure steps per mm
M208 X0:300 Y0:300 Z0:250                                           ; set minimum and maximum axis limits
M566 X600 Y600 Z20                                                  ; set maximum instantaneous speed changes (mm/min)
M203 X11400 Y11400 Z8000                                            ; set maximum speeds (mm/min)
M201 X5000 Y5000 Z1000                                              ; set accelerations (mm/s^2)

; Extruders
M584 E121.0                                                         ; set extruder mapping
M350 E16 I1                                                         ; configure microstepping with interpolation
M906 E650                                                           ; set extruder driver currents
M92 E726                                                            ; configure steps per mm
M566 E300                                                           ; set maximum instantaneous speed changes (mm/min)
M203 E5000                                                          ; set maximum speeds (mm/min)
M201 E1000                                                          ; set accelerations (mm/s^2)

; Kinematics
M669 K1                                                             ; configure CoreXY kinematics
M671 X350:-50:350:-50 Y350:350:-50:-50 S10                          ; z stepper position

; Probes
M558 K0 P8 C"121.io1.in" H5 F2000:75 T10000                         ; configure unfiltered digital probe via slot #0
G31 P500 X0 Y25 Z1.25                                               ; set Z probe trigger value, offset and trigger height (offset macro value: Z)

; Endstops
M574 Y2 P"!io0.in" S1                                               ; configure Y axis endstop
M574 X2 P"!io1.in" S1                                               ; configure X axis endstop
M574 Z1 S2                                                          ; configure Z axis endstop

; Sensors
M308 S0 P"temp0" Y"thermistor" A"Heated Bed" T100000 B4725 C7.06e-8 ; configure sensor #0
M308 S1 P"121.temp0" Y"thermistor" A"Nozzle" T100000 B4725 C7.06e-8 ; configure sensor #1
M308 S2 Y"mcu-temp" A"MCU"                                          ; configure sensor #2 (internal MCU temp)
M308 S3 Y"drivers" A"Drivers"                                       ; configure sensor #3 (internal TMC driver temp)

; Heaters
M950 H0 C"out0" T0                                                  ; create heater #0
M143 H0 P0 T0 C0 S125 A0                                            ; configure heater monitor #0 for heater #0
M307 H0 R2.43 D5.5 E1.35 K0.56 B0                                   ; configure model of heater #0
M950 H1 C"121.out0" T1                                              ; create heater #1
M143 H1 P0 T1 C0 S285 A0                                            ; configure heater monitor #0 for heater #1
M307 H1 R2.43 D5.5 E1.35 K0.56 B0                                   ; configure model of heater #1

; Heated beds
M140 P0 H0                                                          ; configure heated bed #0

; Fans & LEDs
M950 F0 C"121.out1"                                                 ; create fan #0
M106 P0 C"Print Fan" S0 L0 X0.9 B0.1                                ; configure fan #0 and name it

M950 F1 C"121.out2" Q250                                            ; create fan #1
M106 P1 C"Hotend Fan" S0 B0.1 H1 T60 X0.9                           ; configure fan #1 and name it

M950 F2 C"out5" Q250                                                ; create 'fan' #2 for LED strip
M106 P2 C"LED Strip" S0                                             ; name it so it shows as a brightness slider in DWC (Default off)

M950 F3 C"out6" Q250                                                ; create fan #3 for MCU/Drivers
M106 P3 C"Board Fan" H2:3 T50 X0.4                                  ; thermostatic: monitor sensors 2 & 3, scale speed between 40°C and 55°C

; Tools
M563 P0 D0 H1 F0                                                    ; create tool #0
M568 P0 R0 S0                                                       ; set initial tool #0 (Toolhead) active temp to 0C and standby temp to 0C
M570 H1 P4 T15

; Miscellaneous
M501                                                                ; load saved parameters from non-volatile memory
;M911 S0                                                             ; Disable automatic power-loss state saving
T0                                                                  ; select first tool
M950 E0 C"121.io0.out" T2 U3                                        ; configure LED strip #0 (RGBW)
M591 P7 C"121.io2.in" S1 L7 E20 D0                                  ; filament monitor connected to E0 endstop
M557 X25:275 Y25:275 S50                                            ; define grid for mesh bed compensation
M207 S0.8                                                           ; retraction
M572 D0 S0.04                                                       ; pressure advance
;M556 S100 X-0.2 Y-0.2 Z-0.05                                        ; Skew conpensation (Squareness)
M929 P"log.log" S3                                                  ; start logging info to file log.log (S0=off,S1=WARN,S2=INFO,S3=DEBUG)
;M98 P"/macros/Leds On"                                              ; All leds on
;M98 P"truelevel.g"                                                  ; do NOT auto-level on startup (safety first)
M593 P"zvd" F60                                                     ; input shaping
;M452 C"io2.out" R255 F200                                           ; Enable Laser mode, on out6, with max intensity being 255, and a PWM frequency of 200
M451                                                                ; set printer mode